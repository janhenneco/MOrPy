&binary_job

   inlist_names(1) = 'inlist_massive_1' 
   inlist_names(2) = 'inlist_massive_2'

   evolve_both_stars = .true.

/ ! end of binary_job namelist


&binary_controls
         
!!! PHYSICS     
   ! binary system
   m1 = 10.16d0  ! donor mass in Msun
   m2 = 8.128d0 ! companion mass in Msun
   initial_period_in_days = -1
   initial_separation_in_Rsuns = 470.93

   ! orbital jdot controls
   do_jdot_ml = .true.
   do_jdot_gr = .false. ! not relevant for 'living' stars with P_orb < 0.5d
   do_jdot_ls = .true.
   do_jdot_missing_wind = .false.
   do_jdot_mb = .false. ! make sure this is always on .false.

   ! rotation and sync settings
   do_j_accretion = .true.
   do_tidal_sync = .true.

   ! note to self: use conv t_sync based on reasoning in Detmers et al. (2008).
   ! alternatively, a rad/conv switch can be implemented in run_binary_extras.f 
   ! when crossing ~7000 K from the hot to the cool side
   sync_mode_1 = "Uniform"
   sync_type_1 = "Hut_conv"
   Ftid_1 = 1
   sync_mode_2 = "Uniform"
   sync_type_2 = "Hut_conv"
   Ftid_2 = 1

   do_initial_orbit_sync_1 = .true.
   do_initial_orbit_sync_2 = .true.

   ! mass transfer controls
   mdot_scheme = "contact"

   ! stopping criteria
   accretor_overflow_terminate = 100d0 ! allow for contact phase
   max_implicit_abs_mdot = 10d0 ! assume unstable mass transfer if mdot becomes this high -> THIS IS NOT A STOPPING CONDITION!
   terminate_if_L2_overflow = .true.

!!! NUMERICS
   ! timestep controls
   fr = 0.01
   fr_limit = 2.5d-2
   fr_dt_limit = 500
   fm = 1d0
   fm_limit = 1d-1
   fj = 0.001d0
   fj_hard = -1d0
   fa = 0.01d0
   fa_hard = -1d0

   varcontrol_case_a = 1d-4
   varcontrol_case_b = 1d-4
   varcontrol_ms = 1d-4
   varcontrol_post_ms = 5d-4
   dt_softening_factor = 0.4

   ! solver settings
   limit_retention_by_mdot_edd = .false. ! should be .false. when evolve_both_stars = .true.
   implicit_scheme_tolerance = 5d-5
   implicit_lambda = 0.4d0
   min_mdot_for_implicit = 1d-16
   roche_min_mdot = 1d-16
   max_tries_to_achieve = 200 ! > 0 for implicit, < 0 for explicit (Ritter & Kolb)
   min_change_factor = 1.01d0
   max_change_factor = 1.2d0
   initial_change_factor = 1.2d0
   change_factor_fraction = 0.8d0

!!! OUTPUT
   photo_interval = 101
   history_interval = 1
   terminal_interval = 10
   write_header_frequency = 100

   ! debugging
   report_rlo_solver_progress = .false.
         
/ ! end of binary_controls namelist

